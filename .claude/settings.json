{
  "permissions": {
    "allow": [
      "Read(**)",
      "Write(novels/**)",
      "Edit(novels/**)",
      "Write(.claude/**)",
      "Edit(.claude/**)",
      "Bash(python3:*)",
      "Bash(python:*)",
      "Bash(py:*)",
      "Bash(ls:*)",
      "Bash(wc:*)",
      "Bash(find:*)",
      "Bash(grep:*)",
      "Bash(rg:*)",
      "Bash(cp:*)",
      "Bash(mkdir:*)",
      "Bash(cat:*)",
      "Bash(date:*)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Write|Edit|NotebookEdit",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"${CLAUDE_PROJECT_DIR}\"/scripts/hooks/write_scope.py"
          }
        ]
      },
      {
        "matcher": "Read|Grep|Glob",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"${CLAUDE_PROJECT_DIR}\"/scripts/hooks/role_scope.py"
          }
        ]
      }
    ]
  },
  "remoteControlAtStartup": false
}
